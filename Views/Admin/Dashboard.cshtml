@model Staybnb.ViewModels.AdminDashboardVM
@using Staybnb.Services
@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="sb-stats" style="margin-top:0">
    <div class="sb-stat">
        <div class="sb-stat-label">Total Users</div>
        <div class="sb-stat-value">@Model.TotalUsers</div>
        <div class="sb-stat-note sb-good">Active users</div>
    </div>
    <div class="sb-stat @(Model.PendingApplications > 0 ? "sb-stat-attention" : "")">
        <div class="sb-stat-label">Pending Host Apps</div>
        <div class="sb-stat-value">@Model.PendingApplications</div>
        <div class="sb-stat-note"><a asp-action="Applications" asp-route-status="Pending">Require review</a></div>
    </div>
    <div class="sb-stat">
        <div class="sb-stat-label">Active Properties</div>
        <div class="sb-stat-value">@Model.ActiveProperties</div>
        <div class="sb-stat-note sb-good">Listings available</div>
    </div>
    <div class="sb-stat">
        <div class="sb-stat-label">Platform Revenue</div>
        <div class="sb-stat-value">R @Model.PlatformRevenue.ToString("N0")</div>
        <div class="sb-stat-note sb-good">Total earnings</div>
    </div>
    <div class="sb-stat">
        <div class="sb-stat-label">Total Bookings</div>
        <div class="sb-stat-value">@Model.TotalBookings</div>
        <div class="sb-stat-note sb-good">@Model.PendingBookings pending</div>
    </div>
    <div class="sb-stat">
        <div class="sb-stat-label">Approved Hosts</div>
        <div class="sb-stat-value">@Model.ApprovedHosts</div>
        <div class="sb-stat-note sb-good">Active hosts</div>
    </div>
</div>

<h2 class="sb-panel-title" style="margin-top:0">Recent Activity</h2>
<div class="sb-card mb-4">
    <table class="sb-table">
        <thead>
            <tr><th>User</th><th>Action</th><th>Date</th><th>Type</th></tr>
        </thead>
        <tbody>
            @foreach (var l in Model.RecentActivity)
            {
                var who = l.User != null ? NameHelper.Display(l.User) : "System";
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="sb-avatar sb-avatar-sm">@who.Substring(0, 1).ToUpper()</span>
                            <div>@who<br /><span class="sb-muted">@(l.User?.Email)</span></div>
                        </div>
                    </td>
                    <td>@l.Action</td>
                    <td>@l.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><span class="sb-badge sb-badge-pending">@l.ActivityType</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="sb-two-col">
    <div>
        <h2 class="sb-panel-title" style="margin-top:0">Recent Host Applications</h2>
        <div class="sb-card">
            @if (!Model.RecentApplications.Any())
            {
                <p class="sb-muted mb-0">No applications yet.</p>
            }
            else
            {
                <table class="sb-table">
                    <thead><tr><th>Applicant</th><th>Date</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.RecentApplications)
                        {
                            <tr>
                                <td>@NameHelper.Display(a.ApplicationUser)<br /><span class="sb-muted">@a.ApplicationUser.Email</span></td>
                                <td>@a.AppliedAt.ToString("yyyy-MM-dd")</td>
                                <td><partial name="_StatusBadge" model="a.Status" /></td>
                                <td><a asp-action="ApplicationDetails" asp-route-id="@a.Id">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div>
        <h2 class="sb-panel-title" style="margin-top:0">Recent Bookings</h2>
        <div class="sb-card">
            @if (!Model.RecentBookings.Any())
            {
                <p class="sb-muted mb-0">No bookings yet.</p>
            }
            else
            {
                <table class="sb-table">
                    <thead><tr><th>Guest</th><th>Dates</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            var badge = b.Status == Staybnb.Enums.BookingStatus.Approved || b.Status == Staybnb.Enums.BookingStatus.CheckedIn ? "sb-badge-approved"
                                      : b.Status == Staybnb.Enums.BookingStatus.Rejected || b.Status == Staybnb.Enums.BookingStatus.Cancelled ? "sb-badge-rejected"
                                      : "sb-badge-pending";
                            <tr>
                                <td>@NameHelper.Display(b.Guest)<br /><span class="sb-muted">@b.Guest.Email</span></td>
                                <td>@b.CheckInDate.ToString("dd MMM")<br /><span class="sb-muted">to @b.CheckOutDate.ToString("dd MMM")</span></td>
                                <td><span class="sb-badge @badge">@b.Status</span></td>
                                <td><a asp-action="Bookings">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
