@model Staybnb.Models.HostProperty
@{
    var saved = (ViewData["SavedIds"] as HashSet<int>) ?? new HashSet<int>();
    var isSaved = saved.Contains(Model.Id);
    var isGuest = User.IsInRole("Guest");
    var signedIn = User.Identity?.IsAuthenticated == true;
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;
    var slides = Model.Images.Take(5).ToList();
    var photoCount = Model.Images.Count;
    var reviewCount = Model.Reviews.Count;
    var rating = reviewCount > 0 ? Model.Reviews.Average(r => r.Rating) : 0;
}

<div class="sb-listing">
    <div class="sb-listing-media sb-carousel">
        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id" tabindex="-1">
            @if (slides.Count == 0)
            {
                <div class="sb-listing-img"></div>
            }
            else
            {
                @for (var i = 0; i < slides.Count; i++)
                {
                    <img src="@slides[i].ImageUrl" class="sb-listing-img sb-slide @(i == 0 ? "active" : "")" alt="Photo @(i + 1) of @Model.Title" loading="lazy" />
                }
            }
        </a>

        @if (slides.Count > 1)
        {
            <button type="button" class="sb-car-btn prev" aria-label="Previous photo">&#8249;</button>
            <button type="button" class="sb-car-btn next" aria-label="Next photo">&#8250;</button>
            <div class="sb-dots">
                @for (var i = 0; i < slides.Count; i++)
                {
                    <span class="sb-dot @(i == 0 ? "active" : "")"></span>
                }
            </div>
        }

        @if (isGuest)
        {
            <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="sb-heart-form">
                <input type="hidden" name="propertyId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="sb-heart @(isSaved ? "saved" : "")" aria-label="@(isSaved ? "Remove from wishlist" : "Save to wishlist")">
                    <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
            </form>
        }
        else if (!signedIn)
        {
            <a class="sb-heart sb-heart-form" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" aria-label="Log in to save">
                <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </a>
        }

        <span class="sb-photo-count">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
            @photoCount
        </span>
    </div>

    <a class="sb-listing-body" asp-controller="Properties" asp-action="Details" asp-route-id="@Model.Id">
        <div class="sb-listing-meta">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            @Model.City, South Africa
        </div>
        <div class="sb-listing-title">@Model.Title</div>
        <div class="sb-listing-price"><strong>R @Model.PricePerNight.ToString("N0")</strong> <span class="sb-muted">per night</span></div>
        <div class="sb-listing-rating"><span class="sb-star">&#9733;</span> @rating.ToString("0.0") <span class="sb-muted">(@reviewCount)</span></div>
    </a>
</div>
