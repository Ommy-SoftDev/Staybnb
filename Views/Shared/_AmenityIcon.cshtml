@model string?
@{
    var key = (Model ?? "").ToLower();
}
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (key)
    {
        case "wifi":
            <path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line>
            break;
        case "kitchen":
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line>
            break;
        case "washer":
        case "dryer":
            <rect x="3" y="2" width="18" height="20" rx="2"></rect><circle cx="12" cy="14" r="5"></circle><line x1="7" y1="6" x2="7.01" y2="6"></line><line x1="11" y1="6" x2="11.01" y2="6"></line>
            break;
        case "ac":
            <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"></path>
            break;
        case "heating":
            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
            break;
        case "parking":
            <rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
            break;
        case "pool":
            <path d="M2 12c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"></path><path d="M2 18c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"></path>
            break;
        case "tv":
            <rect x="2" y="7" width="20" height="15" rx="2"></rect><polyline points="17 2 12 7 7 2"></polyline>
            break;
        case "balcony":
            <path d="M5 11V6h14v5"></path><rect x="3" y="11" width="18" height="9"></rect><line x1="8" y1="11" x2="8" y2="20"></line><line x1="16" y1="11" x2="16" y2="20"></line>
            break;
        case "braai":
            <path d="M12 2c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"></path>
            break;
        case "workspace":
            <rect x="3" y="4" width="18" height="12" rx="2"></rect><line x1="2" y1="20" x2="22" y2="20"></line>
            break;
        default:
            <circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline>
            break;
    }
</svg>
